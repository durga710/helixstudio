// Helix Studio data model — PostgreSQL via Prisma.
//
// The app runs in demo mode (seeded in-memory store, src/lib/store.ts) until
// DATABASE_URL is configured; this schema is the production persistence layer
// the store interface swaps onto. See docs/DATABASE.md at the repo root.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (DATABASE_URL),
// not in the schema file.
datasource db {
  provider = "postgresql"
}

// ---------- Phase 1 · Users & auth (Auth.js) ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())

  // Guest trial: anonymous accounts created by "Continue as guest".
  // tokensUsed meters AI usage; guests are blocked at GUEST_TOKEN_LIMIT.
  isGuest    Boolean @default(false)
  tokensUsed Int     @default(0)

  accounts      Account[]
  sessions      Session[]
  memberships   TeamMember[]
  memories      MemoryEntry[]
  auditEvents   AuditEvent[]
  chatThreads   ChatThread[]
  workspaces    Workspace[]
  repoWatches   RepoWatch[]
  preferences   UserPreferences?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Editor studio · Workspaces (migrated from GCODE) ----------

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI brain
  aiProvider String  @default("openai") // openai | anthropic | local
  aiModel    String  @default("") // empty = provider default
  aiBaseUrl  String? // for local/custom (OpenAI-compatible)
  // Per-provider keys — switching provider can never send the wrong
  // vendor's key.
  openaiKey    String?
  anthropicKey String?
  localKey     String?

  // Optional GitHub PAT override. When set, it is used INSTEAD of the OAuth
  // token (e.g. a fine-grained token scoped to specific repos).
  githubToken String?

  // Other git hosts connect by pasted token (no OAuth apps — zero-cost,
  // works for self-hosted instances too).
  gitlabToken    String?
  gitlabBaseUrl  String? // self-hosted GitLab; empty = gitlab.com
  bitbucketToken String?
  azureToken     String?
  azureOrg       String? // dev.azure.com/{org}
  giteaToken     String?
  giteaBaseUrl   String? // e.g. https://codeberg.org or self-hosted Gitea/Forgejo

  updatedAt DateTime @updatedAt
}

enum WorkspaceMode {
  SCRATCH
  IMPORT
}

model Workspace {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  mode   WorkspaceMode

  // Which git host this workspace's repo lives on:
  // github | gitlab | bitbucket | azure | gitea
  provider String @default("github")

  // IMPORT mode: the repo this workspace mirrors ("owner/name"; Azure DevOps
  // uses "org/project/repo"). SCRATCH mode: set after the first push so later
  // pushes reuse the repo.
  repo       String?
  baseBranch String? // branch pinned at import / first push

  // Agent-curated project notes (the `remember` tool) — shown to the model at
  // the start of every chat turn. Invisible to the user; never pushed.
  notes String?

  // Cached cloud environment (Vercel Sandbox snapshot with deps installed) so
  // preview + run_command start warm. setupScript null = auto-derived from the
  // stack; envSnapshotKey is a hash of the setup inputs (invalidates on change).
  setupScript    String?
  envSnapshotId  String?
  envSnapshotKey String?
  envReadyAt     DateTime?
  // The current live VM's unique name. Sandbox names are single-use once a
  // snapshot references them, so each VM instance gets a fresh name tracked
  // here (the serverless "find my VM again" handle).
  envSandbox     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files    WorkspaceFile[]
  messages WorkspaceMessage[]
  tasks    WorkspaceTask[]

  @@index([userId, updatedAt])
}

// Background agent turns ("run in background"): same agent machinery as a
// chat turn, executed after the response via next/server after(), tracked
// here so the client can poll status and pick up results.
model WorkspaceTask {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prompt      String
  status      String    @default("queued") // queued | running | done | error
  resultText  String?
  actions     Json?
  changes     Json? // { written: string[], deleted: string[] }
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([workspaceId, createdAt])
}

// Overlay storage: a row exists only for files the AI/user created, modified,
// or deleted on top of the base (the GitHub repo in IMPORT mode, nothing in
// SCRATCH mode). `deleted` tombstones an imported repo file.
model WorkspaceFile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  path        String
  content     String
  deleted     Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, path])
}

// A repo the user has opted into automatic PR review on. Helix installs a
// GitHub webhook (hookId) that calls /api/git/webhook; the per-repo secret
// authenticates incoming events. v1 is GitHub-only.
model RepoWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @default("github")
  repo      String
  secret    String
  hookId    String?
  createdAt DateTime @default(now())

  @@unique([provider, repo])
  @@index([userId])
}

model WorkspaceMessage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String // "user" | "assistant"
  content     String
  actions     Json? // [{tool, label}]
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ---------- Phase 1/2 · Projects & repository intelligence ----------

model Project {
  id          String        @id @default(cuid())
  teamId      String
  name        String
  repoUrl     String
  description String        @default("")
  language    String        @default("TypeScript")
  fileCount   Int           @default(0)
  progress    Int           @default(0)
  health      ProjectHealth @default(REVIEW)
  indexedAt   DateTime?
  createdAt   DateTime      @default(now())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  files       RepoFile[]
  chunks      RepoChunk[]
  analyses    Analysis[]
  agentRuns   AgentRun[]
  deployments Deployment[]
  memories    MemoryEntry[]

  @@index([teamId])
}

enum ProjectHealth {
  HEALTHY
  REVIEW
  ISSUES
}

model RepoFile {
  id        String  @id @default(cuid())
  projectId String
  path      String
  language  String  @default("")
  content   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

// Chunked + embedded content for semantic search (vector lives in Qdrant,
// referenced by qdrantId; the chunk row is the source of truth).
model RepoChunk {
  id        String  @id @default(cuid())
  projectId String
  path      String
  startLine Int
  text      String
  qdrantId  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, path])
}

model Analysis {
  id          String   @id @default(cuid())
  projectId   String
  scanSeconds Float
  overview    Json
  dataFlow    Json
  deps        Json
  risks       Json
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---------- Phase 1/3 · Chat & agent runs ----------

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  projectId String?
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  role      ChatRole
  content   String
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model AgentRun {
  id        String      @id @default(cuid())
  projectId String
  task      String
  status    RunStatus   @default(RUNNING)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps     AgentStep[]

  @@index([projectId, createdAt])
}

model AgentStep {
  id       String    @id @default(cuid())
  runId    String
  agent    String
  status   RunStatus @default(RUNNING)
  logs     Json
  result   String?
  run      AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum RunStatus {
  RUNNING
  DONE
  FAILED
  AWAITING_CONFIRMATION
}

// ---------- Phase 5 · Memory ----------

model MemoryEntry {
  id        String      @id @default(cuid())
  scope     MemoryScope
  title     String
  content   String
  userId    String?
  projectId String?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, updatedAt])
}

enum MemoryScope {
  USER
  PROJECT
  AGENT
}

// ---------- Phase 6 · Deployments ----------

model Deployment {
  id        String      @id @default(cuid())
  projectId String
  env       String
  sha       String
  message   String
  author    String
  state     DeployState @default(BUILDING)
  url       String?
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

enum DeployState {
  READY
  BUILDING
  FAILED
  ROLLED_BACK
}

// ---------- Phase 7 · Teams, RBAC, audit ----------

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  invites   Invite[]
  projects  Project[]
  audit     AuditEvent[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Invite {
  id        String       @id @default(cuid())
  teamId    String
  email     String
  codeHash  String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model AuditEvent {
  id      String   @id @default(cuid())
  teamId  String
  actorId String?
  actor   String
  action  String
  target  String
  at      DateTime @default(now())
  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, at])
}
