// Helix Studio data model — PostgreSQL via Prisma.
//
// The app runs in demo mode (seeded in-memory store, src/lib/store.ts) until
// DATABASE_URL is configured; this schema is the production persistence layer
// the store interface swaps onto. See docs/DATABASE.md at the repo root.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (DATABASE_URL),
// not in the schema file.
datasource db {
  provider = "postgresql"
}

// ---------- Phase 1 · Users & auth (Auth.js) ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())

  // Guest trial: anonymous accounts created by "Continue as guest".
  // tokensUsed meters AI usage (lifetime); guests are blocked at GUEST_TOKEN_LIMIT.
  isGuest    Boolean @default(false)
  tokensUsed Int     @default(0)

  // Tiered monthly AI quotas (TIER_TOKEN_LIMITS in agent-config.ts) with
  // admin overrides. tokenLimit, when set, is the absolute monthly cap and
  // beats the tier default (0 = AI disabled). periodTokens counts the current
  // UTC calendar month and is lazily reset by checkTokenBudget.
  tier         String    @default("free") // free | pro | premium
  tokenLimit   Int?
  suspendedAt  DateTime?
  periodTokens Int       @default(0)
  periodStart  DateTime  @default(now())

  // User-level subscription (tier upgrades). Mirrors the per-Space billing
  // fields; the webhook tells the two apart via subscription metadata.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  accounts      Account[]
  sessions      Session[]
  memberships   TeamMember[]
  memories      MemoryEntry[]
  auditEvents   AuditEvent[]
  chatThreads   ChatThread[]
  workspaces    Workspace[]
  repoWatches   RepoWatch[]
  preferences   UserPreferences?
  deployConnections DeployConnection[]
  ownedSpaces      Space[]                @relation("SpaceOwner")
  spaceMemberships SpaceMember[]
  submissions      AssignmentSubmission[]
  spaceEvents      SpaceEvent[]
  assignedTasks    SpaceTask[]            @relation("TaskAssignee")
  usageEvents      AiUsageEvent[]
}

// One row per AI call that spent tokens — powers the admin per-user usage
// history and CSV export. User.tokensUsed stays the lifetime source of truth;
// these rows are pruned after USAGE_RETENTION_DAYS (90).
model AiUsageEvent {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  kind        String     @default("chat") // chat | review | classroom_review | ledger_ask | undo_preview | rerank
  provider    String     @default("")     // openai | anthropic | local
  model       String     @default("")
  tokens      Int
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------- Helix Space · lightweight team collaboration ----------
// A Space groups people who can see and open each other's shared workspaces
// (separate-but-visible: each member owns their own; only the owner edits).
// Invite is a per-Space join link (joinCode).
model Space {
  id         String        @id @default(cuid())
  name       String
  ownerId    String
  owner      User          @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  joinCode   String        @unique
  createdAt  DateTime      @default(now())
  members    SpaceMember[]
  workspaces Workspace[]

  // "team" (default, peer collaboration) | "classroom" (the owner is the
  // instructor: can create assignments and view linked submission workspaces).
  kind String @default("team")

  // Billing — one subscription per Space, so the fields live inline.
  // plan "free" caps members/assignments; "active" unlocks up to `seats`.
  plan                 String    @default("free") // free | active
  seats                Int       @default(5)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  assignments Assignment[]
  events      SpaceEvent[]
  spaceTasks  SpaceTask[]
}

// ---------- Helix Space v2 · classroom assignments ----------
// An Assignment belongs to a classroom Space. Students start it (the starter
// workspace's files are copied into a workspace they own), work in the normal
// editor, then submit. The instructor reviews each submission read-only,
// optionally runs an AI review, and records feedback + a grade.
model Assignment {
  id      String @id @default(cuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title        String
  instructions String // markdown
  dueAt        DateTime?

  // Template the student copy starts from; null = empty scratch workspace.
  starterWorkspaceId String?
  starterWorkspace   Workspace? @relation("AssignmentStarter", fields: [starterWorkspaceId], references: [id], onDelete: SetNull)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]

  @@index([spaceId, createdAt])
}

// ---------- Helix Space v3 · activity feed + task board ----------
// One row per notable Space action (joined, shared, submitted, graded, …).
// actorName is denormalized so the feed reads cleanly even after the actor's
// account is deleted. Writes are fire-and-forget from the routes.
model SpaceEvent {
  id      String  @id @default(cuid())
  spaceId String
  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorName String
  // joined | left | shared | unshared | assignment_created | submitted |
  // reviewed | pushed | forked | task_added | task_done
  action    String
  target    String // workspace/assignment/task title (display only)
  targetId  String?
  createdAt DateTime @default(now())

  @@index([spaceId, createdAt])
}

// Lightweight per-Space task board (todo | doing | done). Any member can
// create and move tasks; deleting is the creator's or the space owner's call.
model SpaceTask {
  id      String @id @default(cuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title       String
  note        String?
  status      String  @default("todo") // todo | doing | done
  assigneeId  String?
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, status, order])
}

// One row per (assignment, student). Created when the student starts the
// assignment; the unique constraint doubles as the double-start race guard.
// Feedback/grade live here (NOT in WorkspaceMessage — that is the student's
// AI chat history and feeds the agent's context).
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String // the student
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The student's copy. SetNull so the grade record survives workspace deletion.
  workspaceId String?
  workspace   Workspace? @relation("SubmissionWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)

  status      String    @default("in_progress") // in_progress | submitted | reviewed
  submittedAt DateTime?

  grade      String? // free text: "92/100", "A-"
  feedback   String? // instructor's written feedback (markdown)
  aiReview   String? // persisted output of an instructor-run AI review
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([assignmentId, userId])
  @@index([workspaceId])
}

model SpaceMember {
  id       String   @id @default(cuid())
  spaceId  String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Editor studio · Workspaces (migrated from GCODE) ----------

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI brain
  aiProvider String  @default("openai") // openai | anthropic | local
  aiModel    String  @default("") // empty = provider default
  aiBaseUrl  String? // for local/custom (OpenAI-compatible)
  // Per-provider keys — switching provider can never send the wrong
  // vendor's key.
  openaiKey    String?
  anthropicKey String?
  localKey     String?
  geminiKey    String?

  // Optional GitHub PAT override. When set, it is used INSTEAD of the OAuth
  // token (e.g. a fine-grained token scoped to specific repos).
  githubToken String?

  // Other git hosts connect by pasted token (no OAuth apps — zero-cost,
  // works for self-hosted instances too).
  gitlabToken    String?
  gitlabBaseUrl  String? // self-hosted GitLab; empty = gitlab.com
  bitbucketToken String?
  azureToken     String?
  azureOrg       String? // dev.azure.com/{org}
  giteaToken     String?
  giteaBaseUrl   String? // e.g. https://codeberg.org or self-hosted Gitea/Forgejo

  updatedAt DateTime @updatedAt
}

enum WorkspaceMode {
  SCRATCH
  IMPORT
}

model Workspace {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  mode   WorkspaceMode

  // Shared into a Space → Space members can view/open/copy it (read-only).
  // null = private to the owner.
  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Which git host this workspace's repo lives on:
  // github | gitlab | bitbucket | azure | gitea
  provider String @default("github")

  // IMPORT mode: the repo this workspace mirrors ("owner/name"; Azure DevOps
  // uses "org/project/repo"). SCRATCH mode: set after the first push so later
  // pushes reuse the repo.
  repo       String?
  baseBranch String? // branch pinned at import / first push

  // Agent-curated project notes (the `remember` tool) — shown to the model at
  // the start of every chat turn. Invisible to the user; never pushed.
  notes String?

  // Cached cloud environment (Vercel Sandbox snapshot with deps installed) so
  // preview + run_command start warm. setupScript null = auto-derived from the
  // stack; envSnapshotKey is a hash of the setup inputs (invalidates on change).
  setupScript    String?
  envSnapshotId  String?
  envSnapshotKey String?
  envReadyAt     DateTime?
  // The current live VM's unique name. Sandbox names are single-use once a
  // snapshot references them, so each VM instance gets a fresh name tracked
  // here (the serverless "find my VM again" handle).
  envSandbox     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files    WorkspaceFile[]
  messages WorkspaceMessage[]
  tasks    WorkspaceTask[]
  intents  WorkspaceIntent[]
  deploy   WorkspaceDeploy?

  // Classroom assignments (v2): this workspace as a starter template, and as
  // a student's submission copy.
  starterFor            Assignment[]           @relation("AssignmentStarter")
  assignmentSubmissions AssignmentSubmission[] @relation("SubmissionWorkspace")
  usageEvents           AiUsageEvent[]

  @@index([userId, updatedAt])
  @@index([spaceId])
}

// Background agent turns ("run in background"): same agent machinery as a
// chat turn, executed after the response via next/server after(), tracked
// here so the client can poll status and pick up results.
model WorkspaceTask {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prompt      String
  status      String    @default("queued") // queued | running | done | error
  resultText  String?
  actions     Json?
  changes     Json? // { written: string[], deleted: string[] }
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([workspaceId, createdAt])
}

// Overlay storage: a row exists only for files the AI/user created, modified,
// or deleted on top of the base (the GitHub repo in IMPORT mode, nothing in
// SCRATCH mode). `deleted` tombstones an imported repo file.
model WorkspaceFile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  path        String
  content     String
  deleted     Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, path])
}

// ---------- Deploy integrations ----------
// A user's connection to a hosting platform (Vercel, Netlify, Cloudflare
// Pages, Render…). One token per provider; `config` holds provider-specific
// extras (Vercel teamId, Cloudflare accountId, etc.). Mirrors the git-host
// model so new platforms slot in as adapters.
model DeployConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String // vercel | netlify | cloudflare | render
  token     String
  config    Json? // { teamId } | { accountId } | …
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// The hosting project a workspace is linked to. Git-linked: the platform
// auto-builds on every push to the workspace's repo. One per workspace.
model WorkspaceDeploy {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider      String // vercel | netlify | …
  projectId     String // platform project id
  projectName   String // platform project name/slug
  dashboardUrl  String? // link to the platform's project page
  productionUrl String? // the live site
  lastState     String? // READY | BUILDING | ERROR | QUEUED | CANCELED
  lastDeployAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Intent ledger ----------
// One intent per user request that changed files: an agent build turn, a
// manual editor save, or an applied undo. Per-file before/after snapshots
// (WorkspaceChange) power line-level blame and intentional undo.
model WorkspaceIntent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  kind   String @default("agent") // agent | manual | undo
  status String @default("open") // open | final | reverted

  title        String  @default("")
  userRequest  String  @default("")
  planText     String? // approved plan text (Approve & build turns)
  reasoning    String? // assistant's final reply for the turn
  alternatives String? // AI-summarized rejected alternatives

  revertsIntentId String? // kind="undo": the intent this reverses
  createdAt       DateTime @default(now())

  changes WorkspaceChange[]

  @@index([workspaceId, createdAt])
}

// One row per file an intent touched: full content snapshots, not diffs —
// bounded by the per-file size cap, and self-healing for blame (a write that
// bypassed capture shows up as drift, not a broken diff chain).
model WorkspaceChange {
  id          String          @id @default(cuid())
  intentId    String
  intent      WorkspaceIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  workspaceId String // denormalized for the per-path blame query
  path        String

  beforeContent String? // null = file did not exist before this intent
  afterContent  String? // null = this intent deleted the file
  baseUnknown   Boolean  @default(false) // IMPORT base fetch failed
  createdAt     DateTime @default(now())

  @@unique([intentId, path])
  @@index([workspaceId, path, createdAt])
}

// A repo the user has opted into automatic PR review on. Helix installs a
// GitHub webhook (hookId) that calls /api/git/webhook; the per-repo secret
// authenticates incoming events. v1 is GitHub-only.
model RepoWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @default("github")
  repo      String
  secret    String
  hookId    String?
  createdAt DateTime @default(now())

  @@unique([provider, repo])
  @@index([userId])
}

model WorkspaceMessage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String // "user" | "assistant"
  content     String
  actions     Json? // [{tool, label}]
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ---------- Phase 1/2 · Projects & repository intelligence ----------

model Project {
  id          String        @id @default(cuid())
  teamId      String
  name        String
  repoUrl     String
  description String        @default("")
  language    String        @default("TypeScript")
  fileCount   Int           @default(0)
  progress    Int           @default(0)
  health      ProjectHealth @default(REVIEW)
  indexedAt   DateTime?
  createdAt   DateTime      @default(now())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  files       RepoFile[]
  chunks      RepoChunk[]
  analyses    Analysis[]
  agentRuns   AgentRun[]
  deployments Deployment[]
  memories    MemoryEntry[]

  @@index([teamId])
}

enum ProjectHealth {
  HEALTHY
  REVIEW
  ISSUES
}

model RepoFile {
  id        String  @id @default(cuid())
  projectId String
  path      String
  language  String  @default("")
  content   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

// Chunked + embedded content for semantic search (vector lives in Qdrant,
// referenced by qdrantId; the chunk row is the source of truth).
model RepoChunk {
  id        String  @id @default(cuid())
  projectId String
  path      String
  startLine Int
  text      String
  qdrantId  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, path])
}

model Analysis {
  id          String   @id @default(cuid())
  projectId   String
  scanSeconds Float
  overview    Json
  dataFlow    Json
  deps        Json
  risks       Json
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---------- Phase 1/3 · Chat & agent runs ----------

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  projectId String?
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  role      ChatRole
  content   String
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model AgentRun {
  id        String      @id @default(cuid())
  projectId String
  task      String
  status    RunStatus   @default(RUNNING)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps     AgentStep[]

  @@index([projectId, createdAt])
}

model AgentStep {
  id       String    @id @default(cuid())
  runId    String
  agent    String
  status   RunStatus @default(RUNNING)
  logs     Json
  result   String?
  run      AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum RunStatus {
  RUNNING
  DONE
  FAILED
  AWAITING_CONFIRMATION
}

// ---------- Phase 5 · Memory ----------

model MemoryEntry {
  id        String      @id @default(cuid())
  scope     MemoryScope
  title     String
  content   String
  userId    String?
  projectId String?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, updatedAt])
}

enum MemoryScope {
  USER
  PROJECT
  AGENT
}

// ---------- Phase 6 · Deployments ----------

model Deployment {
  id        String      @id @default(cuid())
  projectId String
  env       String
  sha       String
  message   String
  author    String
  state     DeployState @default(BUILDING)
  url       String?
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

enum DeployState {
  READY
  BUILDING
  FAILED
  ROLLED_BACK
}

// ---------- Phase 7 · Teams, RBAC, audit ----------

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  invites   Invite[]
  projects  Project[]
  audit     AuditEvent[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Invite {
  id        String       @id @default(cuid())
  teamId    String
  email     String
  codeHash  String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model AuditEvent {
  id      String   @id @default(cuid())
  teamId  String
  actorId String?
  actor   String
  action  String
  target  String
  at      DateTime @default(now())
  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, at])
}

// ---------- Scaffold templates ----------
// The starter templates injected into new SCRATCH workspaces. Seeded from the
// bundled registry (src/lib/templates/registry.generated.ts) on first read;
// the admin refresh job upserts regenerated, build-verified versions here so
// updates go live without a redeploy. Standalone — no relations.
model Template {
  id           String    @id @default(cuid())
  templateId   String    @unique // e.g. "nextjs-app"
  manifest     Json // TemplateManifest
  files        Json // TemplateFile[]
  source       String    @default("bundle") // bundle | refresh
  refreshState String? // ok | building | error
  refreshError String?
  refreshedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
