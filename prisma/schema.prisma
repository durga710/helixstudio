// Helix Studio data model — PostgreSQL via Prisma.
//
// The app runs in demo mode (seeded in-memory store, src/lib/store.ts) until
// DATABASE_URL is configured; this schema is the production persistence layer
// the store interface swaps onto. See docs/DATABASE.md at the repo root.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (DATABASE_URL),
// not in the schema file.
datasource db {
  provider = "postgresql"
}

// ---------- Phase 1 · Users & auth (Auth.js) ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  memberships   TeamMember[]
  memories      MemoryEntry[]
  auditEvents   AuditEvent[]
  chatThreads   ChatThread[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Phase 1/2 · Projects & repository intelligence ----------

model Project {
  id          String        @id @default(cuid())
  teamId      String
  name        String
  repoUrl     String
  description String        @default("")
  language    String        @default("TypeScript")
  fileCount   Int           @default(0)
  progress    Int           @default(0)
  health      ProjectHealth @default(REVIEW)
  indexedAt   DateTime?
  createdAt   DateTime      @default(now())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  files       RepoFile[]
  chunks      RepoChunk[]
  analyses    Analysis[]
  agentRuns   AgentRun[]
  deployments Deployment[]
  memories    MemoryEntry[]

  @@index([teamId])
}

enum ProjectHealth {
  HEALTHY
  REVIEW
  ISSUES
}

model RepoFile {
  id        String  @id @default(cuid())
  projectId String
  path      String
  language  String  @default("")
  content   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

// Chunked + embedded content for semantic search (vector lives in Qdrant,
// referenced by qdrantId; the chunk row is the source of truth).
model RepoChunk {
  id        String  @id @default(cuid())
  projectId String
  path      String
  startLine Int
  text      String
  qdrantId  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, path])
}

model Analysis {
  id          String   @id @default(cuid())
  projectId   String
  scanSeconds Float
  overview    Json
  dataFlow    Json
  deps        Json
  risks       Json
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---------- Phase 1/3 · Chat & agent runs ----------

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  projectId String?
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  role      ChatRole
  content   String
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model AgentRun {
  id        String      @id @default(cuid())
  projectId String
  task      String
  status    RunStatus   @default(RUNNING)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps     AgentStep[]

  @@index([projectId, createdAt])
}

model AgentStep {
  id       String    @id @default(cuid())
  runId    String
  agent    String
  status   RunStatus @default(RUNNING)
  logs     Json
  result   String?
  run      AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum RunStatus {
  RUNNING
  DONE
  FAILED
  AWAITING_CONFIRMATION
}

// ---------- Phase 5 · Memory ----------

model MemoryEntry {
  id        String      @id @default(cuid())
  scope     MemoryScope
  title     String
  content   String
  userId    String?
  projectId String?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, updatedAt])
}

enum MemoryScope {
  USER
  PROJECT
  AGENT
}

// ---------- Phase 6 · Deployments ----------

model Deployment {
  id        String      @id @default(cuid())
  projectId String
  env       String
  sha       String
  message   String
  author    String
  state     DeployState @default(BUILDING)
  url       String?
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

enum DeployState {
  READY
  BUILDING
  FAILED
  ROLLED_BACK
}

// ---------- Phase 7 · Teams, RBAC, audit ----------

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  invites   Invite[]
  projects  Project[]
  audit     AuditEvent[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Invite {
  id        String       @id @default(cuid())
  teamId    String
  email     String
  codeHash  String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model AuditEvent {
  id      String   @id @default(cuid())
  teamId  String
  actorId String?
  actor   String
  action  String
  target  String
  at      DateTime @default(now())
  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, at])
}
