<%- include('partials/head', { appName: appName }) %>
<div class="flex min-h-screen bg-bg">
  <%- include('partials/sidebar', { appName: appName, page: page }) %>
  <div class="flex min-w-0 flex-1 flex-col">
    <%- include('partials/topbar') %>
    <main class="flex-1 p-6 md:p-8">
      <div class="mx-auto max-w-4xl space-y-6">
        <div>
          <h1 class="text-2xl font-semibold text-ink">Dashboard</h1>
          <p class="text-sm text-muted">Here&rsquo;s what&rsquo;s happening today.</p>
        </div>
        <!-- AI: relabel these for the app's real metrics (or remove). -->
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-line bg-surface p-5"><p class="text-sm text-muted">Items</p><p class="mt-2 text-3xl font-semibold text-ink"><%= items.length %></p></div>
          <div class="rounded-2xl border border-line bg-surface p-5"><p class="text-sm text-muted">Active</p><p class="mt-2 text-3xl font-semibold text-ink">&mdash;</p></div>
          <div class="rounded-2xl border border-line bg-surface p-5"><p class="text-sm text-muted">This week</p><p class="mt-2 text-3xl font-semibold text-ink">&mdash;</p></div>
          <div class="rounded-2xl border border-line bg-surface p-5"><p class="text-sm text-muted">Pending</p><p class="mt-2 text-3xl font-semibold text-ink">&mdash;</p></div>
        </div>
        <!-- AI: BUILD THE APP'S MAIN FEATURE HERE. This HTMX list is the pattern to
             copy: a form hx-post → items.controller renders views/partials/items-list
             → HTMX swaps it into #items. Reuse the tokens + the model/controller split. -->
        <div class="rounded-2xl border border-line bg-surface p-5">
          <h2 class="text-lg font-semibold text-ink">Items</h2>
          <form hx-post="/items" hx-target="#items" hx-swap="innerHTML" hx-on::after-request="this.reset()" class="mt-3 flex gap-2">
            <input name="name" placeholder="Add an item&hellip;" required
              class="h-10 flex-1 rounded-xl border border-line bg-bg px-3 text-sm text-ink outline-none focus:border-brand" />
            <button class="h-10 rounded-xl bg-brand px-4 text-sm font-medium text-brand-fg hover:brightness-110">Add</button>
          </form>
          <div id="items" class="mt-4">
            <%- include('partials/items-list', { items: items }) %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('partials/foot') %>
