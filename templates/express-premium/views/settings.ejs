<%- include('partials/head', { appName: appName }) %>
<div class="flex min-h-screen bg-bg">
  <%- include('partials/sidebar', { appName: appName, page: page }) %>
  <div class="flex min-w-0 flex-1 flex-col">
    <%- include('partials/topbar') %>
    <main class="flex-1 p-6 md:p-8">
      <div class="mx-auto max-w-2xl space-y-6">
        <div>
          <h1 class="text-2xl font-semibold text-ink">Settings</h1>
          <p class="text-sm text-muted">Manage your profile and preferences.</p>
        </div>
        <div class="rounded-2xl border border-line bg-surface p-5">
          <form class="space-y-4">
            <label class="block space-y-1.5">
              <span class="text-sm font-medium text-muted">Display name</span>
              <input value="" placeholder="Ada Lovelace"
                class="h-10 w-full rounded-xl border border-line bg-bg px-3 text-sm text-ink outline-none focus:border-brand" />
            </label>
            <label class="block space-y-1.5">
              <span class="text-sm font-medium text-muted">Email</span>
              <input type="email" value="" placeholder="you@example.com"
                class="h-10 w-full rounded-xl border border-line bg-bg px-3 text-sm text-ink outline-none focus:border-brand" />
            </label>
            <button type="button" class="rounded-xl bg-brand px-4 py-2.5 text-sm font-medium text-brand-fg hover:brightness-110">Save changes</button>
          </form>
        </div>
        <div class="rounded-2xl border border-line bg-surface p-5">
          <h2 class="text-base font-semibold text-ink">Appearance</h2>
          <p class="mt-1 text-sm text-muted">Switch the color palette from the theme picker in the top bar — it applies instantly and is remembered next visit.</p>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('partials/foot') %>
