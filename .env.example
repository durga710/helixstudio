# --- Canonical domain -------------------------------------------------------
# Production: https://helixstudio.org (see docs/DEPLOYMENT.md at the repo root)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers are optional — the sign-in page hides buttons for unset providers.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database ----------------------------------------------------------------
# Optional. Without DATABASE_URL the app runs in demo mode (seeded in-memory data).
# Supabase/PgBouncer: DATABASE_URL = pooled (port 6543), DIRECT_URL = direct
# (port 5432) for migrations. URL-encode special chars in the password (@ -> %40).
# NEVER commit real values here — set them in Vercel env vars or a gitignored
# .env.local. This file holds names/placeholders only.
DATABASE_URL=postgresql://user:password@localhost:5432/helix?schema=public
DIRECT_URL=

# --- AI providers ------------------------------------------------------------
# Optional platform-wide keys. Users can also bring their own key per browser
# (Settings -> AI provider) — BYOK takes precedence over these values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_GENERATIVE_AI_API_KEY=

# House OpenAI: make a strong GPT model the default for EVERY user (not just
# admins) on the platform OPENAI_API_KEY — the operator pays the bill, the normal
# per-user token quota still meters spend. Set OPENAI_FOR_ALL=1, OPENAI_API_KEY,
# and OPENAI_MODEL (e.g. gpt-5.5) together. If the key is rejected / out of
# credits / the model id is wrong, builds fall back to Bedrock GPT-OSS instead of
# failing. Off unless OPENAI_FOR_ALL=1.
OPENAI_FOR_ALL=

# --- Amazon Bedrock (platform-default models, one bearer key for all users) ---
# When AWS_BEARER_TOKEN_BEDROCK is set, Bedrock becomes the default provider and
# its confirmed models surface in Settings -> AI model. Set ALL THREE in the
# SAME environment scope (e.g. Vercel "Production") and redeploy for changes to
# take effect. Check /api/health -> configured.BEDROCK to confirm it's live.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_WORKSPACE_ID=
BEDROCK_REGION=us-east-1

# --- Guest / local model (OpenAI-compatible: LM Studio, Ollama, vLLM) --------
# Pins guest chats to a local model so they never spend the paid keys above.
GUEST_AI_PROVIDER=
GUEST_AI_MODEL=
GUEST_AI_BASE_URL=
LOCAL_AI_API_KEY=

# --- Repository intelligence -------------------------------------------------
# Optional Qdrant vector store; falls back to in-memory search when unset.
QDRANT_URL=
QDRANT_API_KEY=

# --- Deployments ---------------------------------------------------------------
# Optional Vercel API token for live deployment data; simulated otherwise.
VERCEL_TOKEN=

# --- Billing (Stripe) ----------------------------------------------------------
# All four are required to enable the Space upgrade flow (checkout, portal,
# webhook). Free-plan caps apply regardless. PRICE_TEAM/PRICE_EDU are the
# per-seat monthly recurring price IDs; classroom spaces use the EDU price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_EDU=

# --- Shared store (Upstash Redis) ----------------------------------------------
# Makes rate limiting and chat-progress correct across serverless instances.
# Without these the app falls back to per-instance in-memory (fine for local/
# single-instance). Add via Vercel → Integrations → Upstash, which sets both.
# PORTABILITY: standard Redis behind src/lib/redis.ts — swap that one file for
# ioredis + a REDIS_URL to move to AWS ElastiCache / Azure Cache for Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel/Upstash integration alternative (same REST endpoint+token; redis.ts reads either):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Error monitoring (Sentry) -------------------------------------------------
# DSN enables client + server error capture (instrumentation*.ts). Without it
# errors are still logged structurally. PORTABILITY: Sentry lives only in
# src/lib/observability.ts + the instrumentation files — rewrite to move to
# CloudWatch / Application Insights / OpenTelemetry. Errors-only by design
# (no perf tracing, no session replay) to stay within the free tier.
SENTRY_DSN=
# Sentry wizard / Vercel integration sets this; observability.ts reads either:
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only enables source-map upload at build time (so prod stack traces
# are readable). Set automatically in Vercel by the Sentry integration; absent
# locally, the build just skips upload. NOT needed to capture errors.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# NOTE: SENTRY_VERCEL_LOG_DRAIN_URL is NOT an app variable. A Vercel "log drain"
# streams ALL logs to Sentry (a separate, paid-faster quota) and is configured
# in the Vercel/Sentry dashboard, not here. The app never reads it.
